
@'
# Virtual environments
venv/
.venv/

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local vector database (rebuildable from source documents)
data/chroma/

# Generated reports: selected reports will be added explicitly
reports/*
!reports/.gitkeep

# Logs
*.log

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
'@ | Set-Content -Encoding utf8 .gitignore

Get-Content .\.gitignore
